{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/merch/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/nustatyti-slaptazodi",
      "destination": "/index.html"
    },
    {
      "source": "/merch/krepselis",
      "destination": "/index.html"
    },
    {
      "source": "/rinkiniai/krepselis",
      "destination": "/index.html"
    },
    {
      "source": "/merch/aciu",
      "destination": "/index.html"
    },
    {
      "source": "/rinkinys/:id",
      "destination": "/index.html"
    },
    {
      "source": "/profilis/:userId",
      "destination": "/index.html"
    },
    {
      "source": "/paskyra",
      "destination": "/index.html"
    },
    {
      "source": "/apmokejimas",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/archive",
      "destination": "/rinkiniai",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/paskyra",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/bendruomene",
      "permanent": true
    },
    {
      "source": "/gift-cards",
      "destination": "/dovanu-kuponas",
      "permanent": true
    },
    {
      "source": "/subscribe",
      "destination": "/prenumerata",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/apmokejimas",
      "permanent": true
    },
    {
      "source": "/drop/:id",
      "destination": "/rinkinys/:id",
      "permanent": true
    },
    {
      "source": "/profile/:userId",
      "destination": "/profilis/:userId",
      "permanent": true
    }
  ]
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/protect-files.sh'",
            "timeout": 10,
            "statusMessage": "Checking file protections..."
          },
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/warn-large-files.sh'",
            "timeout": 10,
            "statusMessage": "Checking for build artifacts..."
          },
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/scan-secrets.sh'",
            "timeout": 10,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/block-dangerous-commands.sh'",
            "timeout": 10,
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/format-on-save.sh'",
            "timeout": 30,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/gvozdovic/Desktop/projects/bricktime/.codex/hooks/session-start.sh'",
            "timeout": 10,
            "statusMessage": "Loading project context..."
          }
        ]
      }
    ]
  }
}
